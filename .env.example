# Friday configuration
#
# Copy this file to .env and fill in your own values:
#     cp .env.example .env
# .env is git-ignored. Never commit real credentials.
# Values set in the process environment take precedence over .env.
# Every value below is a placeholder.

# ---------------------------------------------------------------------------
# AWS credentials (shared by Amazon Bedrock, Amazon Transcribe, Amazon Polly)
# ---------------------------------------------------------------------------

# REQUIRED. AWS access key ID.
AWS_ACCESS_KEY_ID=your-aws-access-key-id

# REQUIRED. AWS secret access key.
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# OPTIONAL. AWS session token. Default: unset.
# Required when using temporary (sandbox) AWS credentials, which come as an
# access key ID, secret access key, and session token. Leave empty for
# long-term IAM user keys.
AWS_SESSION_TOKEN=

# REQUIRED. AWS region for Bedrock, Transcribe, and Polly calls.
# Suggested value: us-east-2
AWS_REGION=us-east-2

# ---------------------------------------------------------------------------
# Bedrock LLM
# ---------------------------------------------------------------------------

# REQUIRED. Bedrock model ID.
# Suggested value: us.openai.gpt-5.6-terra
# This is the US cross-Region inference profile for GPT-5.6 Terra, called
# through the Amazon Bedrock runtime Converse API.
BEDROCK_MODEL_ID=us.openai.gpt-5.6-terra

# ---------------------------------------------------------------------------
# FRED
# ---------------------------------------------------------------------------

# REQUIRED. FRED API key (https://fred.stlouisfed.org/docs/api/api_key.html).
FRED_API_KEY=your-fred-api-key

# ---------------------------------------------------------------------------
# Speech
# ---------------------------------------------------------------------------

# OPTIONAL. Amazon Polly voice ID. Default: Joanna
POLLY_VOICE_ID=Joanna

# OPTIONAL. Amazon Polly engine. Default: neural
POLLY_ENGINE=neural

# OPTIONAL. Amazon Transcribe language code. Default: en-US
TRANSCRIBE_LANGUAGE_CODE=en-US

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------

# OPTIONAL. Path to a custom Indicator_Map JSON file.
# Default: unset (uses the built-in map of 10 monthly FRED indicators).
INDICATOR_MAP_PATH=

# OPTIONAL. Port the Backend listens on (127.0.0.1 only). Default: 8000
FRIDAY_PORT=8000
